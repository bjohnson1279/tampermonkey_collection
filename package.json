{
  "name": "tampermonkey-collection",
  "version": "1.0.0",
  "description": "Collection of Tampermonkey scripts",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "generate:extensions": "node scripts/generate-extensions.js",
    "generate:icons": "node scripts/generate-icons.js",
    "prepare": "husky install",
    "generate:all": "npm run build && npm run generate:extensions && npm run generate:icons",
    "postinstall": "npm run generate:all"
  },
  "keywords": [
    "tampermonkey",
    "userscripts",
    "browser-extensions"
  ],
  "author": "Brent Johnson",
  "license": "MIT",
  "devDependencies": {
    "@types/greasemonkey": "^4.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  },
  "resolutions": {
    "canvas": "3.2.3"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "brace-expansion": {
      "brace-expansion": "$brace-expansion"
    }
  },
  "config": {
    "optional": "false"
  }
}
